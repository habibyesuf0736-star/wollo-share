# ---------------------------------------------------------------------------
# Wollo Share — environment template.  Copy to .env and fill in.
# Nothing in this file is a real secret; .env itself is never committed.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
PORT=3000
# Signs every session cookie. Must be long and random, and must stay stable —
# changing it signs every student out.
SESSION_SECRET=replace-with-a-long-random-secret

# --- state store --------------------------------------------------------------
# "supabase" keeps the whole document in one JSONB row (production); "file" keeps
# it in data/wollo-db.json (local development). Unset means "file".
WOLLO_STATE_STORE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URLs are an alternative transport for the same row; the pooled
# one is used when present.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- local data directory -----------------------------------------------------
# Where the "file" store keeps wollo-db.json. Defaults to ./data.
WOLLO_DATA_DIR=

# --- server-side secrets ------------------------------------------------------
# Both have built-in defaults in the code. Every stored password hash was made
# with the current values, so SETTING THESE INVALIDATES EVERY ACCOUNT: they are
# left unset unless the whole store is being rehashed from scratch.
WOLLO_SECURITY_PEPPER=
WOLLO_VAULT_MASTER_KEY=

# --- Google sign-in -----------------------------------------------------------
# Optional. Read from firebase-applet-config.json when unset; only the public web
# API key and project id are used, and the server verifies the token with them.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=

# --- email delivery -----------------------------------------------------------
# Providers are tried in this order: Hyvor Relay, SMTP, Brevo, Mailtrap. Fill in
# one block; leave the others empty. Admin → Users → Email delivery can override
# these at runtime without a restart. See docs/email-templates.md.
ADMIN_NOTIFICATION_EMAIL=

RELAY_API_URL=
RELAY_API_KEY=
RELAY_FROM=
RELAY_TIMEOUT_MS=15000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

BREVO_API_KEY=
BREVO_FROM=
BREVO_TIMEOUT_MS=15000

MAILTRAP_API_TOKEN=
MAILTRAP_FROM=
MAILTRAP_TEMPLATE_UUID=
MAILTRAP_TIMEOUT_MS=15000

# --- build --------------------------------------------------------------------
# npm run build prerenders one HTML page per program for search engines. This is
# how long it waits for Supabase before falling back to the local snapshot.
WOLLO_PRERENDER_TIMEOUT_MS=20000
