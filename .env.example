PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# Server-side encryption secrets (leave unset to use built-in defaults; set real values in production)
WOLLO_SECURITY_PEPPER=
WOLLO_VAULT_MASTER_KEY=

# SMTP credentials are loaded from the server environment; never commit real credentials.
# Optional fallback only. Mail settings saved in Admin → Users → Email delivery are stored
# encrypted in data/wollo-db.json and override these values without a restart. See docs/hyvor-relay.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=habibyesuf81@gmail.com

# Brevo HTTPS API (https://developers.brevo.com) — sends over port 443, so no SMTP port and
# no IP allowlist is involved. The API key starts with xkeysib-; the sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_FROM=
BREVO_TIMEOUT_MS=15000

# Mailtrap HTTPS API (https://mailtrap.io) — also port 443. The API token belongs to a
# sending domain, and the sender address must be a verified Mailtrap sender.
MAILTRAP_API_TOKEN=
MAILTRAP_FROM=
MAILTRAP_TEMPLATE_UUID=
MAILTRAP_TIMEOUT_MS=15000

# Hyvor Relay (https://github.com/hyvor/relay) — preferred sender for verification codes.
# When URL + key + sender are known, mail goes to Relay instead of SMTP.
RELAY_API_URL=
RELAY_API_KEY=
RELAY_FROM=
RELAY_TIMEOUT_MS=15000
