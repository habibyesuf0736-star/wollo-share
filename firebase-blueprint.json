{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student or Admin user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "department": { "type": "string" },
        "accountPlan": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Curated academic course offering in Wollo Share",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "department": { "type": "string" },
        "semester": { "type": "string" },
        "code": { "type": "string" },
        "materialsCount": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "Material": {
      "title": "Material",
      "description": "Academic study material, handout, or exam archive",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "fileType": { "type": "string" },
        "uploaderName": { "type": "string" },
        "uploaderEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "courseId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document indexed by user UID"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Public academic courses directory"
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Public academic study materials & past exams repository"
    }
  }
}
