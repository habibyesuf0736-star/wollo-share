{
  "name": "wollo-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wollo University student material library: a React SPA in front of an Express API that keeps its whole state in one Supabase row.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/habibyesuf0736-star/wollo-share.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/local.ts",
    "start": "tsx server/local.ts",
    "build": "vite build && tsx scripts/prerender-seo.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "db:status": "tsx scripts/supabase-sync.ts status",
    "db:init": "node scripts/supabase-init.mjs",
    "db:push": "tsx scripts/supabase-sync.ts push",
    "db:pull": "tsx scripts/supabase-sync.ts pull"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.1.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
